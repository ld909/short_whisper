{
  "pipeline": {
    "name": "演示管道",
    "version": "1.0",
    "timeout_seconds": 10,
    "max_retries": 1,
    "retry_delay_seconds": 1
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(message)s",
    "console_output": true,
    "file_output": true,
    "log_directory": "logs"
  },
  "system_rules": {
    "mac_skip_scripts": [],
    "mac_skip_reason": "🍎 检测到Mac系统，自动跳过此步骤"
  },
  "steps": [
    {
      "script": "demo_step1.py",
      "step_number": "1",
      "description": "演示步骤1 - 成功",
      "required": true,
      "timeout_override": null,
      "max_retries_override": null
    },
    {
      "script": "demo_step2.py",
      "step_number": "2",
      "description": "演示步骤2 - 失败重试",
      "required": true,
      "timeout_override": null,
      "max_retries_override": 2
    },
    {
      "script": "demo_step3.py",
      "step_number": "3",
      "description": "演示步骤3 - 成功",
      "required": true,
      "timeout_override": null,
      "max_retries_override": null
    }
  ]
}