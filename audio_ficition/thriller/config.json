    "thriller_subgenres": {
        "select_multiple": false,
        "options": [
            {
                "name": "Psychological Thriller",
                "description": "Focuses on characters' inner struggles, mental states, and twisted psychology. Plot revolves around unreliable narrators, memory loss, psychological manipulation, and identity crises. Suspense comes from 'who are the good guys and who are the bad guys?' and 'what really happened?'"
            },
            {
                "name": "Crime Thriller",
                "description": "Stories revolve around criminal events, focusing on 'preventing' crimes or the tension and confrontation in pursuing criminals. Serial killer themes are the most popular branch within this subgenre."
            },
            {
                "name": "Action/Adventure Thriller",
                "description": "Filled with chases, fights, explosions, and global adventures. Protagonists are usually 'lone hero' characters with exceptional abilities who must overcome numerous obstacles in a very short time to thwart massive conspiracies."
            },
            {
                "name": "Legal Thriller",
                "description": "Stories set in courtrooms and law firms. Suspense comes from trial debates, legal loopholes, evidence gathering, and corruption and struggles within the judicial system."
            },
            {
                "name": "Domestic Noir/Domestic Suspense",
                "description": "'Danger comes from within the family.' Stories focus on dark secrets between marriages, parent-child relationships, and community neighborhoods. Behind seemingly perfect family lives hide lies, betrayal, and violence."
            },
            {
                "name": "Spy Thriller/Espionage Thriller",
                "description": "Protagonists are spies or intelligence personnel, with stories revolving around international conspiracies, intelligence warfare, betrayal, and assassination. Plots are complex and often involve geopolitics and national security."
            },
            {
                "name": "Political Thriller",
                "description": "Stories focus on power struggles at high government levels, political scandals, and national-level conspiracies. Settings are usually in power centers like Washington D.C."
            },
            {
                "name": "Techno-Thriller",
                "description": "The core driving force of the story is advanced or fictional science and technology, especially military technology. Plots contain extensive descriptions of technological details."
            },
            {
                "name": "Medical Thriller",
                "description": "Stories revolve around deadly viruses, medical accidents, ethical controversies, and biotechnology conspiracies. Protagonists are usually doctors or scientists."
            },
            {
                "name": "Supernatural Thriller/Horror Thriller",
                "description": "Combines the fast-paced, high-stakes plots of thriller novels with supernatural elements from horror novels. Suspense comes not only from human threats but also from ghosts, demons, or other unexplained forces."
            }
        ]
    },
